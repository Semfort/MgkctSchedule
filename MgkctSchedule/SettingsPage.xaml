<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MgkctSchedule.ViewModels"
             x:Class="MgkctSchedule.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F2F4F8, Dark=#0E1014}">

    <Grid RowDefinitions="Auto,*">

        <!-- заголовок с кнопкой назад -->
        <Grid Padding="8,6,16,6" ColumnDefinitions="Auto,*" ColumnSpacing="4">
            <Button Text="‹" Clicked="OnBackClicked" WidthRequest="48" HeightRequest="44" Padding="0"
                    FontSize="28" BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#14171C, Dark=#F1F3F7}"/>
            <Label Grid.Column="1" Text="Настройки" FontSize="22" FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#14171C, Dark=#F1F3F7}"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,32" Spacing="8">

                <!-- занятия -->
                <Label Text="ЗАНЯТИЯ" FontSize="12" FontAttributes="Bold" Margin="6,10,0,0"
                       TextColor="{AppThemeBinding Light=#5B6472, Dark=#9AA3B2}"/>
                <Border StrokeThickness="0" Padding="16,12"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1E25}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Группа" VerticalOptions="Center" FontSize="16"
                                   TextColor="{AppThemeBinding Light=#14171C, Dark=#F1F3F7}"/>
                            <Picker Grid.Column="1" WidthRequest="170" ItemsSource="{Binding Groups}"
                                    SelectedItem="{Binding SelectedGroup}" FontSize="16"
                                    TextColor="{AppThemeBinding Light=#14171C, Dark=#F1F3F7}"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E6EAF2, Dark=#2A2F3A}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Сокращённые звонки" FontSize="16"
                                       TextColor="{AppThemeBinding Light=#14171C, Dark=#F1F3F7}"/>
                                <Label Text="Включайте в дни с сокращёнными уроками" FontSize="12"
                                       TextColor="{AppThemeBinding Light=#5B6472, Dark=#9AA3B2}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding ShortBells}" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- уведомления -->
                <Label Text="УВЕДОМЛЕНИЯ" FontSize="12" FontAttributes="Bold" Margin="6,14,0,0"
                       TextColor="{AppThemeBinding Light=#5B6472, Dark=#9AA3B2}"/>
                <Border StrokeThickness="0" Padding="12,12,16,12"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1E25}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                            <CheckBox IsChecked="{Binding NotifyTomorrow}" VerticalOptions="Start"
                                      Color="{AppThemeBinding Light=#2F6BFF, Dark=#6B96FF}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="0,8,0,0">
                                <Label Text="Пары на завтра" FontSize="16"
                                       TextColor="{AppThemeBinding Light=#14171C, Dark=#F1F3F7}"/>
                                <Label Text="После последней пары придёт сообщение со списком пар на следующий учебный день"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#5B6472, Dark=#9AA3B2}"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Button Text="Показать пробное уведомление" Command="{Binding TestNotificationCommand}"
                                CornerRadius="14" FontSize="14"
                                BackgroundColor="{AppThemeBinding Light=#E6EAF2, Dark=#2A2F3A}"
                                TextColor="{AppThemeBinding Light=#14171C, Dark=#F1F3F7}"/>
                        <Label Text="{Binding Status}" IsVisible="{Binding HasStatus}" FontSize="12"
                               TextColor="{AppThemeBinding Light=#B45309, Dark=#FBBF24}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- о приложении -->
                <Label Text="О ПРИЛОЖЕНИИ" FontSize="12" FontAttributes="Bold" Margin="6,14,0,0"
                       TextColor="{AppThemeBinding Light=#5B6472, Dark=#9AA3B2}"/>
                <Border StrokeThickness="0" Padding="16,12"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1E25}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <Label Text="{Binding AboutText}" FontSize="14"
                           TextColor="{AppThemeBinding Light=#5B6472, Dark=#9AA3B2}"/>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
